# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cohttp-eio handler for aws-api"
description: """
Handles the aws-api HTTP effect with a cohttp-eio client. Kept separate from
the core packages so that callers that bring their own HTTP client do not pull
in eio and cohttp."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-api.ml"
bug-reports: "https://github.com/lmdexpr/aws-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "aws-api" {= version}
  "eio"
  "cohttp-eio"
  "http"
  "alcotest" {with-test}
  "eio_main" {with-test}
  "uri" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-api.ml.git"
x-maintenance-intent: ["(latest)"]
