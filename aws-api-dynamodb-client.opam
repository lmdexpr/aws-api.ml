# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Typed DynamoDB client over aws-api-dynamodb"
description: """
Attribute values as a variant with exact decimal numbers, conversion to and
from ordinary JSON, a table client with conditional idioms and pagination,
transactions, and single-table design helpers. Built on the generated
aws-api-dynamodb."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-api.ml"
bug-reports: "https://github.com/lmdexpr/aws-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "yojson"
  "base64"
  "ppx_yojson_conv"
  "uri"
  "aws-api" {= version}
  "sigv4" {= version}
  "aws-api-dynamodb" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-api.ml.git"
x-maintenance-intent: ["(latest)"]
