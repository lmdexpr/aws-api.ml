# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "DynamoDB JSON 1.0 protocol: requests, responses, errors"
description: """
Request encoding, response decoding and error parsing for PutItem, GetItem,
DeleteItem, UpdateItem, Query, Scan and TransactWriteItems. Items carry every
DynamoDB attribute type; numbers are exact decimals. Aws_api_dynamodb.Http signs each
request with sigv4 and performs it through the aws-api HTTP effect."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-api.ml"
bug-reports: "https://github.com/lmdexpr/aws-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "yojson"
  "base64"
  "ppx_yojson_conv"
  "uri"
  "aws-api" {= version}
  "sigv4" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-api.ml.git"
x-maintenance-intent: ["(latest)"]
