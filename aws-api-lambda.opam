# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "AWS Lambda Runtime API (2018-06-01) custom-runtime loop, I/O-agnostic"
description: """
The AWS Lambda Runtime API loop used by custom runtimes (next invocation,
response, error). The HTTP round trip is an OCaml 5 effect; Aws_api_lambda.Http
performs it through the aws-api HTTP effect. The core performs no I/O."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-api.ml"
bug-reports: "https://github.com/lmdexpr/aws-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "uri"
  "aws-api" {= version}
  "alcotest" {with-test}
  "aws-api-cohttp-eio" {with-test}
  "eio" {with-test}
  "eio_main" {with-test}
  "cohttp-eio" {with-test}
  "http" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-api.ml.git"
x-maintenance-intent: ["(latest)"]
