# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "AWS Systems Manager (SSM) client, generated from the Smithy model"
description: """
Request and response types and one module per operation, generated by
smithy/smithy_gen.exe from the AWS Smithy model. Signs with sigv4 and performs the aws-api HTTP effect."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-api.ml"
bug-reports: "https://github.com/lmdexpr/aws-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "yojson"
  "base64"
  "ppx_yojson_conv"
  "uri"
  "aws-api" {= version}
  "sigv4" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-api.ml.git"
x-maintenance-intent: ["(latest)"]
