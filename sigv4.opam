# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "AWS Signature Version 4 (header-based signing), I/O-agnostic"
description: """
A pure OCaml implementation of AWS SigV4 header signing. It performs no HTTP
requests, no credential fetching, and no clock reads: the caller injects time,
credentials, and the request to be signed. Credential providers (static, env,
profile files, ECS container endpoint, EC2 IMDSv2, and the SDK default chain)
are included; their I/O is injected. Conforms to the AWS SigV4 v4 test suite
(header signing)."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/aws-api.ml"
bug-reports: "https://github.com/lmdexpr/aws-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "uri"
  "digestif"
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/aws-api.ml.git"
x-maintenance-intent: ["(latest)"]
